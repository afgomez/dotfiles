// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "markdown_preview_font_size": 16.0,
  "agent_ui_font_size": 16.0,
  "agent_buffer_font_size": 13.0,
  "diff_view_style": "split",
  "completion_menu_item_kind": "off",
  "document_symbols": "on",
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "show_count_badge": false,
    "dock": "right",
  },
  "cli_default_open_behavior": "new_window",
  "context_servers": {
    "mcp-server-linear": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_config_options": {
        "mode": "default",
      },
    },
  },
  "debugger": {
    "stepping_granularity": "statement",
  },
  "document_folding_ranges": "on",
  "which_key": {
    "enabled": false,
  },
  "tab_size": 2,
  "use_system_window_tabs": true,
  "unnecessary_code_fade": 0.5,
  "edit_predictions": {
    "mode": "subtle",
  },
  "edit_predictions_disabled_in": ["comment"],
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "temporal.download"
      ]
    },
    "enable_feedback": false,
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "left",
    "use_modifier_to_send": false,
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
    },
    "single_file_review": true,
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
    },
    "show_merge_conflict_indicator": false,
  },
  "base_keymap": "Zed",
  "telemetry": {
    "metrics": true,
    "diagnostics": true,
  },
  "wrap_guides": [80],
  "use_smartcase_search": true,
  "seed_search_query_from_cursor": "selection",
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "PragmataPro",
  "buffer_font_size": 14.0,
  "buffer_line_height": "standard",
  "buffer_font_features": { "calt": 0 },
  "terminal": {
    "font_family": "PragmataPro",
    "show_count_badge": false,
    "font_size": 14.0,
    "line_height": "standard",
  },
  "project_panel": {
    "dock": "right",
    "entry_spacing": "standard",
  },
  "inlay_hints": {
    "show_value_hints": false,
  },
  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "tabs": {
    "file_icons": true,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "autosave": "on_focus_change",

  // Language overrides
  "languages": {
    "Markdown": {
      "format_on_save": "on",
    },
    "Rust": {
      "tab_size": 4,
    },
  },

  // LSP overrides
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "typeAware": true,
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "preferTypeOnlyAutoImports": true,
          },
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "preferences": {
            "preferTypeOnlyAutoImports": true,
          },
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
    },
  },

  // Extensions I use everywhere
  "auto_install_extensions": {
    "basher": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "colored-zed-icons-theme": true,
    "docker-compose": true,
    "dockerfile": true,
    "git-firefly": true,
    "sql": true,
    "toml": true,
    "xml": true,
  },
}
